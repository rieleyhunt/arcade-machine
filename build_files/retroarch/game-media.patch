+static const char *scraper_media_types[SCRAPER_MEDIA_LAST] = {
+   "video-normalized",
+   "ss",
+   "sstitle",
+   "box-2D"
+};
+
+static const char *scraper_media_dirs[SCRAPER_MEDIA_LAST] = {
+   "Named_Snaps",
+   "Named_Snaps",
+   "Named_Titles",
+   "Named_Boxarts"
+};
+
+static const char *scraper_regions[] = { "us", "wor", "eu", "ss", "jp" };
+
+/* Prefix match, so that e.g. every "MAME 2003-Plus" variant maps to MAME */
+static unsigned scraper_get_system_id(const char *name)
+{
+   size_t i;
+   if (!name || !*name)
+      return 0;
+   for (i = 0; i < ARRAY_SIZE(scraper_systems); i++)
+      if (!strncmp(name, scraper_systems[i].name,
+               strlen(scraper_systems[i].name)))
+         return scraper_systems[i].id;
+   return 0;
+}
+
+static int scraper_region_score(const char *region)
+{
+   size_t i;
+   for (i = 0; i < ARRAY_SIZE(scraper_regions); i++)
+      if (string_is_equal(region, scraper_regions[i]))
+         return (int)(ARRAY_SIZE(scraper_regions) - i) + 1;
+   return 1;
+}
+
+static void scraper_free_picks(scraper_handle_t *h)
+{
+   unsigned i;
+   for (i = 0; i < SCRAPER_MEDIA_LAST; i++)
+   {
+      free(h->picks[i].url);
+      h->picks[i].url       = NULL;
+      h->picks[i].score     = 0;
+      h->picks[i].format[0] = '\0';
+   }
+   free(h->synopsis);
+   h->synopsis       = NULL;
+   h->synopsis_score = 0;
+   free(h->response);
+   h->response       = NULL;
+   h->response_len   = 0;
+}
+
+/*****************/
+/* JSON response */
+/*****************/
+
+typedef struct scraper_json_ctx
+{
+   char *url;
+   char *text;
+   scraper_handle_t *h;
+   unsigned record_depth;
+   char container[SCRAPER_JSON_DEPTH + 1][SCRAPER_KEY_LEN];
+   char member[SCRAPER_JSON_DEPTH + 1][SCRAPER_KEY_LEN];
+   char type[SCRAPER_KEY_LEN];
+   char region[SCRAPER_KEY_LEN];
+   char format[8];
+} scraper_json_ctx_t;
+
+static void scraper_json_commit(scraper_json_ctx_t *ctx, unsigned depth)
+{
+   scraper_handle_t *h = ctx->h;
+
+   if (string_is_equal(ctx->container[depth], "synopsis"))
+   {
+      int score = string_is_equal(ctx->region, "en") ? 2 : 1;
+      if (ctx->text && score > h->synopsis_score)
+      {
+         free(h->synopsis);
+         h->synopsis       = ctx->text;
+         h->synopsis_score = score;
+         ctx->text         = NULL;
+      }
+   }
+   else if (ctx->url)
+   {
+      unsigned i;
+      int score = scraper_region_score(ctx->region);
+
+      for (i = 0; i < SCRAPER_MEDIA_LAST; i++)
+      {
+         int s = score;
+         if (i == SCRAPER_MEDIA_VIDEO)
+         {
+            /* Normalized clips are smaller and loop cleanly */
+            if (string_is_equal(ctx->type, "video"))
+               s = 1;
+            else if (string_is_equal(ctx->type, scraper_media_types[i]))
+               s = 2;
+            else
+               continue;
+         }
+         else if (!string_is_equal(ctx->type, scraper_media_types[i]))
+            continue;
+
+         if (s > h->picks[i].score)
+         {
+            free(h->picks[i].url);
+            h->picks[i].url   = ctx->url;
+            h->picks[i].score = s;
+            strlcpy(h->picks[i].format, ctx->format,
+                  sizeof(h->picks[i].format));
+            ctx->url          = NULL;
+         }
+         break;
+      }
+   }
+
+   free(ctx->url);
+   free(ctx->text);
+   ctx->url       = NULL;
+   ctx->text      = NULL;
+   ctx->type[0]   = '\0';
+   ctx->region[0] = '\0';
+   ctx->format[0] = '\0';
+}
+
+/* Collects synopsis and media records from response.jeu */
+static bool scraper_parse_response(scraper_handle_t *h)
+{
+   scraper_json_ctx_t *ctx;
+   rjson_t *json;
+   bool ok = false;
+
+   if (!h->response || !h->response_len)
+      return false;
+   if (!(json = rjson_open_buffer(h->response, h->response_len)))
+      return false;
+   if (!(ctx = (scraper_json_ctx_t*)calloc(1, sizeof(*ctx))))
+   {
+      rjson_free(json);
+      return false;
+   }
+
+   ctx->h = h;
+   rjson_set_options(json, RJSON_OPTION_ALLOW_UTF8BOM
+         | RJSON_OPTION_REPLACE_INVALID_ENCODING);
+
+   for (;;)
+   {
+      size_t _len;
+      const char *str;
+      unsigned depth;
+      enum rjson_type type = rjson_next(json);
+
+      if (type == RJSON_DONE)
+      {
+         ok = true;
+         break;
+      }
+      if (type == RJSON_ERROR)
+         break;
+
+      depth = rjson_get_context_depth(json);
+      if (depth > SCRAPER_JSON_DEPTH)
+         continue;
+
+      switch (type)
+      {
+         case RJSON_OBJECT:
+         case RJSON_ARRAY:
+            if (depth > 0)
+            {
+               /* An array element takes the array's name */
+               if (rjson_check_context(json, 2, RJSON_ARRAY, type)
+                     || (depth > 1 && *ctx->container[depth - 1]
+                        && !*ctx->member[depth - 1]))
+                  strlcpy(ctx->container[depth], ctx->container[depth - 1],
+                        sizeof(ctx->container[depth]));
+               else
+                  strlcpy(ctx->container[depth], ctx->member[depth - 1],
+                        sizeof(ctx->container[depth]));
+               ctx->member[depth][0] = '\0';
+            }
+            if (     type == RJSON_OBJECT
+                  && depth >= 3
+                  && string_is_equal(ctx->container[depth - 2], "jeu")
+                  && (   string_is_equal(ctx->container[depth], "medias")
+                      || string_is_equal(ctx->container[depth], "synopsis")))
+               ctx->record_depth = depth;
+            break;
+         case RJSON_OBJECT_END:
+            if (ctx->record_depth && depth + 1 == ctx->record_depth)
+            {
+               scraper_json_commit(ctx, ctx->record_depth);
+               ctx->record_depth = 0;
+            }
+            break;
+         case RJSON_STRING:
+            str = rjson_get_string(json, &_len);
+            if (rjson_get_context_type(json) != RJSON_OBJECT)
+               break;
+            if ((rjson_get_context_count(json) & 1) == 1)
+            {
+               strlcpy(ctx->member[depth], str, sizeof(ctx->member[depth]));
+               break;
+            }
+            if (!ctx->record_depth || depth != ctx->record_depth)
+               break;
+            if (string_is_equal(ctx->member[depth], "type"))
+               strlcpy(ctx->type, str, sizeof(ctx->type));
+            else if (string_is_equal(ctx->member[depth], "region")
+                  || string_is_equal(ctx->member[depth], "langue"))
+               strlcpy(ctx->region, str, sizeof(ctx->region));
+            else if (string_is_equal(ctx->member[depth], "format"))
+               strlcpy(ctx->format, str, sizeof(ctx->format));
+            else if (string_is_equal(ctx->member[depth], "url"))
+            {
+               free(ctx->url);
+               ctx->url = strldup(str, _len + 1);
+            }
+            else if (string_is_equal(ctx->member[depth], "text"))
+            {
+               free(ctx->text);
+               ctx->text = strldup(str, _len + 1);
+            }
+            break;
+         default:
+            break;
+      }
+   }
+
+   free(ctx->url);
+   free(ctx->text);
+   free(ctx);
+   rjson_free(json);
+   return ok;
+}
+
+/*********/
+/* HTTP  */
+/*********/
+
+static void cb_scraper_query(retro_task_t *task, void *task_data,
+      void *user_data, const char *err)
+{
+   http_transfer_data_t *data = (http_transfer_data_t*)task_data;
+   scraper_handle_t *h        = (scraper_handle_t*)user_data;
+
+   if (!h)
+      return;
+
+   h->http_status = data ? data->status : 0;
+   if (data && data->data && data->len && data->status == 200)
+   {
+      if ((h->response = (char*)malloc(data->len + 1)))
+      {
+         memcpy(h->response, data->data, data->len);
+         h->response[data->len] = '\0';
+         h->response_len        = data->len;
+      }
+   }
+
+   retro_atomic_store_release_int(&h->http_done, 1);
+   task_queue_wake(h->ident);
+}
+
+static void cb_scraper_download(retro_task_t *task, void *task_data,
+      void *user_data, const char *err)
+{
+   http_transfer_data_t *data = (http_transfer_data_t*)task_data;
+   file_transfer_t *transf    = (file_transfer_t*)user_data;
+   scraper_handle_t *h        = NULL;
+
+   if (!transf)
+      return;
+
+   if ((h = (scraper_handle_t*)transf->user_data))
+   {
+      retro_atomic_store_release_int(&h->http_done, 1);
+      task_queue_wake(h->ident);
+   }
+
+   if (err && *err)
+      RARCH_ERR("[Scraper] Download \"%s\" failed: %s\n", transf->path, err);
+   else if (!data || data->status != 200)
+      RARCH_ERR("[Scraper] Download \"%s\" failed: HTTP %d\n",
+            transf->path, data ? data->status : 0);
+   else
+      RARCH_LOG("[Scraper] Downloaded \"%s\".\n", transf->path);
+
+   free(transf);
+}
+
+/* The callbacks write into the handle, so it outlives any transfer
+ * still in flight - even when cancelled. */
+static bool scraper_http_pending(retro_task_t *task, scraper_handle_t *h,
+      retro_time_t park_usec)
+{
+   if (h->http_task && !retro_atomic_load_acquire_int(&h->http_done))
+   {
+      task_queue_park(task, park_usec);
+      return true;
+   }
+   h->http_task = NULL;
+   return false;
+}
+
+static size_t scraper_append_param(char *s, size_t len,
+      const char *key, const char *value)
+{
+   char *enc   = NULL;
+   size_t _len = strlen(s);
+
+   if (!value)
+      return _len;
+   net_http_urlencode(&enc, value);
+   if (!enc)
+      return _len;
+   _len += snprintf(s + _len, len - _len, "&%s=%s", key, enc);
+   free(enc);
+   return _len;
+}
+
+static bool scraper_push_query(scraper_handle_t *h)
+{
+   char num[24];
+   char *url = (char*)malloc(SCRAPER_URL_MAX);
+
+   if (!url)
+      return false;
+
+   snprintf(url, SCRAPER_URL_MAX, "%s?output=json", SCRAPER_API_URL);
+   scraper_append_param(url, SCRAPER_URL_MAX, "devid",       h->devid);
+   scraper_append_param(url, SCRAPER_URL_MAX, "devpassword", h->devpassword);
+   scraper_append_param(url, SCRAPER_URL_MAX, "softname",    SCRAPER_SOFTNAME);
+   if (*h->ssid)
+   {
+      scraper_append_param(url, SCRAPER_URL_MAX, "ssid",       h->ssid);
+      scraper_append_param(url, SCRAPER_URL_MAX, "sspassword", h->sspassword);
+   }
+   snprintf(num, sizeof(num), "%u", h->system_id);
+   scraper_append_param(url, SCRAPER_URL_MAX, "systemeid", num);
+   scraper_append_param(url, SCRAPER_URL_MAX, "romtype",   "rom");
+   scraper_append_param(url, SCRAPER_URL_MAX, "romnom",
+         path_basename_nocompression(h->rom_path));
+   snprintf(num, sizeof(num), "%lld", (long long)h->rom_size);
+   scraper_append_param(url, SCRAPER_URL_MAX, "romtaille", num);
+   if (h->has_crc)
+   {
+      snprintf(num, sizeof(num), "%08X", (unsigned)h->crc);
+      scraper_append_param(url, SCRAPER_URL_MAX, "crc", num);
+   }
+
+   h->http_status = 0;
+   retro_atomic_store_release_int(&h->http_done, 0);
+   h->http_task = (retro_task_t*)task_push_http_transfer(url, true, NULL,
+         cb_scraper_query, h);
+   free(url);
+
+   if (!h->http_task)
+   {
+      retro_atomic_store_release_int(&h->http_done, 1);
+      return false;
+   }
+   return true;
+}
+
+/* Creates the parent directory of 'path' */
+static bool scraper_mkdir_parent(char *path)
+{
+   bool ok;
+   char c;
+   char *slash = find_last_slash(path);
+   if (!slash)
+      return false;
+   c      = *slash;
+   *slash = '\0';
+   ok     = path_mkdir(path);
+   *slash = c;
+   return ok;
+}
+
+static bool scraper_push_download(scraper_handle_t *h, unsigned i)
+{
+   const char *ext;
+   file_transfer_t *transf;
+
+   ext = *h->picks[i].format ? h->picks[i].format
+      : (i == SCRAPER_MEDIA_VIDEO ? "mp4" : "png");
+
+   if (!(transf = (file_transfer_t*)calloc(1, sizeof(*transf))))
+      return false;
+
+   transf->enum_idx  = MSG_UNKNOWN;
+   transf->user_data = h;
+   if (!gfx_thumbnail_get_media_path(h->path_data, h->dir_thumbnails,
+            scraper_media_dirs[i], "", transf->path, sizeof(transf->path)))
+   {
+      free(transf);
+      return false;
+   }
+   strlcat(transf->path, ".", sizeof(transf->path));
+   strlcat(transf->path, ext, sizeof(transf->path));
+
+   if (!scraper_mkdir_parent(transf->path))
+   {
+      free(transf);
+      return false;
+   }
+
+   retro_atomic_store_release_int(&h->http_done, 0);
+   if (!(h->http_task = (retro_task_t*)task_push_http_download_file(
+         h->picks[i].url, transf->path, true, NULL,
+         cb_scraper_download, transf)))
+   {
+      retro_atomic_store_release_int(&h->http_done, 1);
+      free(transf);
+      return false;
+   }
+   return true;
+}
+
+/************/
+/* Entries  */
+/************/
+
+static bool scraper_media_exists(scraper_handle_t *h, const char *sub_dir,
+      const char *ext)
+{
+   return gfx_thumbnail_get_media_path(h->path_data, h->dir_thumbnails,
+         sub_dir, ext, h->scratch, sizeof(h->scratch))
+      && path_is_valid(h->scratch);
+}
+
+static void scraper_write_description(scraper_handle_t *h)
+{
+   if (     h->synopsis
+         && gfx_thumbnail_get_media_path(h->path_data, h->dir_thumbnails,
+            "Named_Descriptions", ".txt", h->scratch, sizeof(h->scratch))
+         && scraper_mkdir_parent(h->scratch))
+      filestream_write_file(h->scratch, h->synopsis, strlen(h->synopsis));
+}
+
+/* Decides what the current entry is missing; false skips it */
+static bool scraper_prepare_entry(scraper_handle_t *h)
+{
+   const struct playlist_entry *entry = NULL;
+   const char *delim;
+   bool have_snap;
+
+   playlist_get_index(h->playlist, h->list_index, &entry);
+   if (!entry || !entry->path || !*entry->path)
+      return false;
+
+   if (!gfx_thumbnail_set_content_playlist(h->path_data,
+            h->playlist, h->list_index))
+      return false;
+
+   h->system_id = scraper_get_system_id(h->path_data->content_db_name);
+   if (!h->system_id)
+      h->system_id = scraper_get_system_id(h->path_data->system);
+   if (!h->system_id)
+      return false;
+
+   have_snap = scraper_media_exists(h, "Named_Snaps", ".png")
+            || scraper_media_exists(h, "Named_Snaps", ".jpg")
+            || scraper_media_exists(h, "Named_Snaps", ".mp4");
+   h->need_media[SCRAPER_MEDIA_VIDEO] = !have_snap;
+   h->need_media[SCRAPER_MEDIA_SNAP]  = !have_snap;
+   h->need_media[SCRAPER_MEDIA_TITLE] =
+         !scraper_media_exists(h, "Named_Titles", ".png");
+   h->need_media[SCRAPER_MEDIA_BOX]   =
+         !scraper_media_exists(h, "Named_Boxarts", ".png");
+   h->need_desc                       =
+         !scraper_media_exists(h, "Named_Descriptions", ".txt");
+
+   if (     !h->need_media[SCRAPER_MEDIA_VIDEO]
+         && !h->need_media[SCRAPER_MEDIA_TITLE]
+         && !h->need_media[SCRAPER_MEDIA_BOX]
+         && !h->need_desc)
+      return false;
+
+   /* Content inside an archive is identified by the archive */
+   strlcpy(h->rom_path, entry->path, sizeof(h->rom_path));
+   if ((delim = path_get_archive_delim(h->rom_path)))
+      h->rom_path[delim - h->rom_path] = '\0';
+
+   if (!path_is_valid(h->rom_path))
+      return false;
+   h->rom_size = path_get_size(h->rom_path);
+
+   h->has_crc  = false;
+   if (     entry->crc32
+         && strlen(entry->crc32) >= 8
+         && strncmp(entry->crc32, "00000000", 8)
+         && strncmp(entry->crc32, "DETECT", 6)
+         && !delim)
+   {
+      h->crc     = (uint32_t)strtoul(entry->crc32, NULL, 16);
+      h->has_crc = (h->crc != 0);
+   }
+   return true;
+}
+
+static void scraper_fail(scraper_handle_t *h, enum msg_hash_enums msg)
+{
+   strlcpy(h->error, msg_hash_to_str(msg), sizeof(h->error));
+   h->status = SCRAPER_END;
+}
+
+/* Returns true once the current entry's query is done with */
+static bool scraper_handle_status(retro_task_t *task, scraper_handle_t *h)
+{
+   switch (h->http_status)
+   {
+      case 200:
+         h->status = SCRAPER_PARSE;
+         return true;
+      case 429:
+         /* Thread limit: back off and ask again */
+         if (h->retries++ < SCRAPER_RETRY_MAX)
+         {
+            h->status = SCRAPER_QUERY;
+            task_queue_park(task, SCRAPER_RETRY_USEC);
+            return false;
+         }
+         break;
+      case 403:
+         scraper_fail(h, MSG_SCREENSCRAPER_LOGIN_FAILED);
+         return true;
+      case 401:
+      case 423:
+      case 426:
+         scraper_fail(h, MSG_SCREENSCRAPER_UNAVAILABLE);
+         return true;
+      case 430:
+      case 431:
+         scraper_fail(h, MSG_SCREENSCRAPER_QUOTA);
+         return true;
+      case 0:
+         scraper_fail(h, MSG_SCREENSCRAPER_UNAVAILABLE);
+         return true;
+      default:
+         break;
+   }
+   RARCH_LOG("[Scraper] No match for \"%s\" (HTTP %d).\n",
+         h->rom_path, h->http_status);
+   h->list_index++;
+   h->status = SCRAPER_NEXT_ENTRY;
+   return true;
+}
+
+static void scraper_free_handle(scraper_handle_t *h)
+{
+   if (h->hash_file)
+      filestream_close(h->hash_file);
+   if (h->playlist)
+      playlist_free(h->playlist);
+   if (h->playlists)
+      string_list_free(h->playlists);
+   scraper_free_picks(h);
+   free(h->path_data);
+   free(h->dir_playlist);
+   free(h->dir_thumbnails);
+   free(h->devid);
+   free(h->devpassword);
+   free(h->ssid);
+   free(h->sspassword);
+   free(h);
+}
+
+static bool scraper_playlist_supported(const char *path)
+{
+   const char *name = path_basename_nocompression(path);
+   return   name
+         && !string_ends_with(name, "_history.lpl")
+         && !string_is_equal(name, FILE_PATH_CONTENT_FAVORITES);
+}
+
+static void task_screenscraper_handler(retro_task_t *task)
+{
+   uint8_t flg;
+   scraper_handle_t *h = NULL;
+
+   if (!task || !(h = (scraper_handle_t*)task->state))
+      goto task_finished;
+
+   flg = task_get_flags(task);
+   if ((flg & RETRO_TASK_FLG_CANCELLED) > 0)
+   {
+      if (scraper_http_pending(task, h, SCRAPER_HTTP_PARK_USEC))
+         return;
+      goto task_finished;
+   }
+
+   switch (h->status)
+   {
+      case SCRAPER_BEGIN:
+         if (!(h->path_data = gfx_thumbnail_path_init()))
+            goto task_finished;
+         h->playlists = dir_list_new(h->dir_playlist, "lpl",
+               false, false, false, false);
+         if (!h->playlists || !h->playlists->size)
+         {
+            h->status = SCRAPER_END;
+            break;
+         }
+         dir_list_sort(h->playlists, true);
+         h->playlist_idx = 0;
+         h->status       = SCRAPER_NEXT_PLAYLIST;
+         break;
+
+      case SCRAPER_NEXT_PLAYLIST:
+         if (h->playlist)
+         {
+            playlist_free(h->playlist);
+            h->playlist = NULL;
+         }
+         if (h->playlist_idx >= h->playlists->size)
+         {
+            h->status = SCRAPER_END;
+            break;
+         }
+         {
+            char system[NAME_MAX_LENGTH];
+            const char *path = h->playlists->elems[h->playlist_idx++].data;
+
+            if (!scraper_playlist_supported(path))
+               break;
+
+            playlist_config_set_path(&h->playlist_config, path);
+            if (!(h->playlist = playlist_init(&h->playlist_config)))
+               break;
+
+            strlcpy(system, path_basename_nocompression(path), sizeof(system));
+            path_remove_extension(system);
+            gfx_thumbnail_path_reset(h->path_data);
+            if (!gfx_thumbnail_set_system(h->path_data, system, h->playlist))
+               break;
+
+            h->list_size  = playlist_size(h->playlist);
+            h->list_index = 0;
+            h->status     = SCRAPER_NEXT_ENTRY;
+         }
+         break;
+
+      case SCRAPER_NEXT_ENTRY:
+         if (h->list_index >= h->list_size)
+         {
+            h->status = SCRAPER_NEXT_PLAYLIST;
+            break;
+         }
+         if (!scraper_prepare_entry(h))
+         {
+            h->list_index++;
+            break;
+         }
+
+         h->total++;
+         task_free_title(task);
+         task_set_title(task, strdup(h->path_data->content_label));
+         task_set_progress(task, (int8_t)((h->list_index * 100)
+               / (h->list_size ? h->list_size : 1)));
+
+         h->crc     = 0;
+         h->retries = 0;
+         if (     !h->has_crc
+               && h->rom_size > 0
+               && h->rom_size <= SCRAPER_HASH_MAX
+               && (h->hash_file = filestream_open(h->rom_path,
+                     RETRO_VFS_FILE_ACCESS_READ,
+                     RETRO_VFS_FILE_ACCESS_HINT_NONE)))
+            h->status = SCRAPER_HASH;
+         else
+            h->status = SCRAPER_QUERY;
+         break;
+
+      case SCRAPER_HASH:
+         {
+            nbio_budget_t b;
+            uint8_t *buf = (uint8_t*)malloc(SCRAPER_HASH_CHUNK);
+            bool eof     = (buf == NULL);
+
+            task_nbio_slice_open(&b);
+            while (!eof && task_nbio_slice_within_budget(&b, 0, 0))
+            {
+               int64_t rd = filestream_read(h->hash_file, buf,
+                     SCRAPER_HASH_CHUNK);
+               if (rd <= 0)
+                  eof = true;
+               else
+                  h->crc = encoding_crc32(h->crc, buf, (size_t)rd);
+            }
+            task_nbio_slice_close(&b);
+            free(buf);
+
+            if (eof)
+            {
+               filestream_close(h->hash_file);
+               h->hash_file = NULL;
+               h->has_crc   = true;
+               h->status    = SCRAPER_QUERY;
+            }
+         }
+         break;
+
+      case SCRAPER_QUERY:
+         if (scraper_http_pending(task, h, SCRAPER_HTTP_PARK_USEC))
+            break;
+         if (h->http_status)
+         {
+            /* Answer to the last request */
+            if (scraper_handle_status(task, h))
+               h->http_status = 0;
+            break;
+         }
+         scraper_free_picks(h);
+         if (!scraper_push_query(h))
+            scraper_fail(h, MSG_SCREENSCRAPER_UNAVAILABLE);
+         break;
+
+      case SCRAPER_PARSE:
+         if (!scraper_parse_response(h))
+         {
+            RARCH_ERR("[Scraper] Unreadable response for \"%s\".\n",
+                  h->rom_path);
+            h->list_index++;
+            h->status = SCRAPER_NEXT_ENTRY;
+            break;
+         }
+         h->found++;
+         if (h->need_desc)
+            scraper_write_description(h);
+         /* A still in Named_Snaps would hide the video */
+         if (h->picks[SCRAPER_MEDIA_VIDEO].url)
+            h->need_media[SCRAPER_MEDIA_SNAP] = false;
+         h->media_idx = 0;
+         h->status    = SCRAPER_DOWNLOAD;
+         break;
+
+      case SCRAPER_DOWNLOAD:
+         if (scraper_http_pending(task, h, SCRAPER_HTTP_PARK_USEC))
+            break;
+         while (     h->media_idx < SCRAPER_MEDIA_LAST
+                 && (   !h->need_media[h->media_idx]
+                     || !h->picks[h->media_idx].url))
+            h->media_idx++;
+         if (h->media_idx >= SCRAPER_MEDIA_LAST)
+         {
+            h->list_index++;
+            h->status = SCRAPER_NEXT_ENTRY;
+            break;
+         }
+         scraper_push_download(h, h->media_idx++);
+         break;
+
+      case SCRAPER_END:
+      default:
+         task_set_progress(task, 100);
+         task_free_title(task);
+         if (*h->error)
+         {
+            task_set_title(task, strdup(h->error));
+            task_set_error(task, strdup(h->error));
+         }
+         else
+         {
+            char msg[NAME_MAX_LENGTH];
+            snprintf(msg, sizeof(msg),
+                  msg_hash_to_str(MSG_SCREENSCRAPER_DONE),
+                  h->found, h->total);
+            task_set_title(task, strdup(msg));
+         }
+         goto task_finished;
+   }
+
+   return;
+
+task_finished:
+   if (task)
+      task_set_flags(task, RETRO_TASK_FLG_FINISHED, true);
+   if (h)
+   {
+      task->state = NULL;
+      scraper_free_handle(h);
+   }
+}
+
+static bool task_screenscraper_finder(retro_task_t *task, void *user_data)
+{
+   return task && task->handler == task_screenscraper_handler;
+}
+
+bool task_push_screenscraper_fetch(
+      const playlist_config_t *playlist_config,
+      const char *dir_playlist,
+      const char *dir_thumbnails,
+      const char *devid,
+      const char *devpassword,
+      const char *ssid,
+      const char *sspassword)
+{
+   task_finder_data_t find_data;
+   retro_task_t *task   = NULL;
+   scraper_handle_t *h  = NULL;
+
+   if (     !playlist_config
+         || !dir_playlist   || !*dir_playlist
+         || !dir_thumbnails || !*dir_thumbnails
+         || !devid          || !*devid)
+      return false;
+
+   find_data.func     = task_screenscraper_finder;
+   find_data.userdata = NULL;
+   if (task_queue_find(&find_data))
+      return false;
+
+   if (!(task = task_init()))
+      return false;
+   if (!(h = (scraper_handle_t*)calloc(1, sizeof(*h))))
+   {
+      free(task);
+      return false;
+   }
+
+   playlist_config_copy(playlist_config, &h->playlist_config);
+   h->dir_playlist   = strdup(dir_playlist);
+   h->dir_thumbnails = strdup(dir_thumbnails);
+   h->devid          = strdup(devid);
+   h->devpassword    = strdup(devpassword ? devpassword : "");
+   h->ssid           = strdup(ssid        ? ssid        : "");
+   h->sspassword     = strdup(sspassword  ? sspassword  : "");
+   h->ident          = task->ident;
+   h->status         = SCRAPER_BEGIN;
+   retro_atomic_int_init(&h->http_done, 0);
+
+   task->handler     = task_screenscraper_handler;
+   task->state       = h;
+   task->title       = strdup(msg_hash_to_str(MSG_SCREENSCRAPER_FETCHING));
+   task->progress    = 0;
+   task->progress_cb = task_window_progress_cb;
+   task->flags      |= RETRO_TASK_FLG_ALTERNATIVE_LOOK;
+
+   task_queue_push(task);
+   return true;
+}
