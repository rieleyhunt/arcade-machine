    return strlcpy(s, path_basename_nocompression(tmp_buf), len);
 }
 
+size_t gfx_thumbnail_get_media_path(gfx_thumbnail_path_data_t *path_data,
+      const char *dir_thumbnails, const char *sub_dir, const char *ext,
+      char *s, size_t len)
+{
+   char system_dir[NAME_MAX_LENGTH];
+   char tmp_buf[DIR_MAX_LENGTH];
+   size_t _len;
+
+   if (     !path_data
+         || !*path_data->content_img
+         || !dir_thumbnails || !*dir_thumbnails)
+      return 0;
+
+   if (*path_data->content_db_name)
+      strlcpy(system_dir, path_data->content_db_name, sizeof(system_dir));
+   else if (   !strcmp(path_data->system, "history")
+            || !strcmp(path_data->system, "favorites"))
+   {
+      if (!gfx_thumbnail_get_content_dir(path_data,
+               system_dir, sizeof(system_dir)))
+         return 0;
+   }
+   else if (*path_data->system)
+      strlcpy(system_dir, path_data->system, sizeof(system_dir));
+   else
+      return 0;
+
+   fill_pathname_join_special(s, dir_thumbnails, system_dir, len);
+   fill_pathname_join_special(tmp_buf, s, sub_dir, sizeof(tmp_buf));
+   fill_pathname_join_special(s, tmp_buf, path_data->content_img, len);
+   path_remove_extension(s);
+   _len = strlen(s);
+   return _len + strlcpy(s + _len, ext, len - _len);
+}
