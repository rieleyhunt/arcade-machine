+/* Loads the fetched description of the selected content, if any */
+static void ozone_update_content_description(ozone_handle_t *ozone,
+      gfx_thumbnail_path_data_t *path_data)
+{
+   char path[PATH_MAX_LENGTH];
+   void *buf   = NULL;
+   int64_t len = 0;
+
