+      return;
+   strlcpy(ozone->selection_description_path, path,
+         sizeof(ozone->selection_description_path));
+   ozone->selection_description[0] = '\0';
+
+   if (     !*path
+         || path_get_size(path) > (int64_t)sizeof(ozone->selection_description)
+         || !filestream_read_file(path, &buf, &len)
+         || !buf)
+      return;
+
+   (ozone->word_wrap)(ozone->selection_description,
+         sizeof(ozone->selection_description),
+         (const char*)buf, (size_t)len,
+         (ozone->dimensions.thumbnail_bar_width
+               - ((ozone->dimensions.sidebar_entry_icon_padding * 2) * 2))
+               / ozone->fonts.footer.glyph_width,
+         ozone->fonts.footer.wideglyph_width, 0);
+   free(buf);
+}
