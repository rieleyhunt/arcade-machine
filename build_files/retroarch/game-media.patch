+   enum scraper_status status;
+   bool has_crc;
+   bool need_desc;
+   bool need_media[SCRAPER_MEDIA_LAST];
+   char rom_path[PATH_MAX_LENGTH];
+   /* Path scratch kept off the stack, which handlers share */
+   char scratch[PATH_MAX_LENGTH];
+   char error[NAME_MAX_LENGTH];
+} scraper_handle_t;
+
